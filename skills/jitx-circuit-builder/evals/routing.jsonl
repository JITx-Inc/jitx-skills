// Routing fixtures for jitx-circuit-builder: should-trigger / should-not-trigger phrasings.
// Positives paraphrase real user phrasing for the lanes this skill owns — netting ports
// together, choosing and inserting queried passives, decoupling, and basic top-level pours.
// Negatives are near-misses that share circuit vocabulary but belong to a sibling: the
// boundary that matters most is passives (choosing and placing a QUERIED passive is here;
// MODELLING a part from a datasheet is the component modeler) and rules (connecting copper
// is here; constraining its width or clearance is jitx-layout-constraints).
{"intent": "wire up the buck converter and connect its feedback divider", "expected_skill": "jitx-circuit-builder"}
{"intent": "tie all 96 ground balls on this BGA to one net", "expected_skill": "jitx-circuit-builder"}
{"intent": "drop a 100 nF decoupling cap on every VDD pin and add a ground pour under the part", "expected_skill": "jitx-circuit-builder"}
{"intent": "connect the capacitor bank to the rail and ground nets", "expected_skill": "jitx-circuit-builder", "ambiguous_with": ["jitx-layout-constraints"]}
{"intent": "my rail net only has half the pins I expected — how do I assert connectivity in a test?", "expected_skill": "jitx-circuit-builder"}
{"intent": "build the application circuit for this LDO — input caps, output caps, enable pull-up", "expected_skill": "jitx-circuit-builder"}
{"intent": "pick a 1% 10k resistor for the divider and one for the pull-up", "expected_skill": "jitx-circuit-builder"}
{"intent": "these three regulator stages are copy-pasted — make them one block", "expected_skill": "jitx-circuit-builder"}
{"intent": "I got 'Incompatible ports on Net: Port and list' when I tied the ground rail", "expected_skill": "jitx-circuit-builder"}
{"intent": "what temperature coefficient should I ask for on these decoupling caps", "expected_skill": "jitx-circuit-builder"}
{"intent": "add a ground pour on the bottom layer of the top-level design", "expected_skill": "jitx-circuit-builder"}
{"intent": "connect the sensor's I2C to the MCU and put the pull-ups at the bus level", "expected_skill": "jitx-circuit-builder"}
